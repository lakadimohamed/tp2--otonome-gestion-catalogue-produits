
const produits = [
    {
        id: 1,
        nom: "Clavier",
        categorie: "Accessoires",
        prix: 120,
        stock: 5
    },
    {
        id: 2,
        nom: "Souris",
        categorie: "Accessoires",
        prix: 80,
        stock: 8
    },
    {
        id: 3,
        nom: "Écran",
        categorie: "Informatique",
        prix: 900,
        stock: 0
    },
    {
        id: 4,
        nom: "Casque",
        categorie: "Accessoires",
        prix: 240,
        stock: 3
    }
];

console.log("=== DONNEES DE DEPART ===");
console.log(produits);
console.log("=== Catalogue des produits ===");

for (const produit of produits) {
    console.log(produit.nom + " - " + produit.prix + " MAD");
}
console.log("=== TEST 2 : Tous les stocks à zéro ===");

const produitsTest = produits.map(produit => ({
    ...produit,
    stock: 0
}));

const produitsDisponibles = produitsTest.filter(
    produit => produit.stock > 0
);

console.log("Nombre de produits disponibles :", produitsDisponibles.length);

if (produitsDisponibles.length === 0) {
    console.log("Aucun produit disponible");
}
console.log("=== TEST 3 : Catalogue vide ===");

const catalogueVide = [];

const valeurTotale = catalogueVide.reduce(
    (total, produit) => total + produit.prix * produit.stock,
    0
);

console.log("Valeur totale du stock :", valeurTotale, "MAD");
console.log("=== TEST 4 : Vérification des données ===");

for (const produit of produits) {
    if (
        typeof produit.prix === "number" &&
        typeof produit.stock === "number" &&
        produit.prix >= 0 &&
        produit.stock >= 0
    ) {
        console.log(produit.nom + " : Données valides");
    } else {
        console.log(produit.nom + " : Données invalides");
    }
}
function estValide(produit) {
    return (
        Number.isFinite(produit.prix) &&
        produit.prix >= 0 &&
        Number.isFinite(produit.stock) &&
        produit.stock >= 0
    );
}
console.log("=== TEST DE LA FONCTION estValide ===");

for (const produit of produits) {
    if (estValide(produit)) {
        console.log(produit.nom + " : Produit valide");
    } else {
        console.log(produit.nom + " : Produit invalide");
    }
}
console.log("=== DESTRUCTURATION DU PRODUIT LE MOINS CHER ===");

const disponiblesDefi2 = produits.filter(produit => produit.stock > 0);

if (disponiblesDefi2.length > 0) {
    const moinsCherDefi2 = disponiblesDefi2.reduce((min, produit) => {
        return produit.prix < min.prix ? produit : min;
    });

    const { nom, prix } = moinsCherDefi2;

    console.log("Produit le moins cher :", nom);
    console.log("Prix :", prix, "MAD");
} else {
    console.log("Aucun produit disponible");
}
